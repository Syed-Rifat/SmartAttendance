@{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}

<div class="sidebar">
    <div class="brand">
        <h4><i class="bi bi-calendar-check"></i> Smart Attendance</h4>
        <small>Management System</small>
    </div>

    <nav class="nav flex-column mt-2">
        @if (role == "Admin")
        {
            <div class="nav-section">Dashboard</div>
            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-divider"></div>
            <div class="nav-section">Management</div>
            <a class="nav-link" asp-controller="Admin" asp-action="Students">
                <i class="bi bi-people"></i> Students
            </a>
            <a class="nav-link" asp-controller="Admin" asp-action="Teachers">
                <i class="bi bi-person-badge"></i> Teachers
            </a>
            <a class="nav-link" asp-controller="Admin" asp-action="Courses">
                <i class="bi bi-book"></i> Courses
            </a>

            <div class="nav-divider"></div>
            <div class="nav-section">Assignments</div>
            <a class="nav-link" asp-controller="Admin" asp-action="Assignments">
                <i class="bi bi-diagram-3"></i> Course Assignments
            </a>
            <a class="nav-link" asp-controller="Admin" asp-action="Enrollments">
                <i class="bi bi-person-plus"></i> Enrollments
            </a>

            <div class="nav-divider"></div>
            <div class="nav-section">Tools</div>
            <a class="nav-link" asp-controller="Admin" asp-action="BulkUploadStudents">
                <i class="bi bi-upload"></i> Bulk Upload
            </a>
            <a class="nav-link" asp-controller="Admin" asp-action="ActivityLogs">
                <i class="bi bi-clock-history"></i> Activity Logs
            </a>
        }
        else if (role == "Teacher")
        {
            <div class="nav-section">Teacher Panel</div>
            <a class="nav-link" asp-controller="Teacher" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i> My Courses
            </a>
        }
        else if (role == "Student")
        {
            <div class="nav-section">Student Panel</div>
            <a class="nav-link" asp-controller="Student" asp-action="MyAttendance">
                <i class="bi bi-bar-chart-line"></i> My Attendance
            </a>
        }

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <div class="nav-divider"></div>
            <div class="nav-section">Account</div>
            <a class="nav-link" asp-controller="Account" asp-action="Settings">
                <i class="bi bi-gear"></i> Settings
            </a>
        }
    </nav>
</div>
