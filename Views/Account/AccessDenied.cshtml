@{
    ViewData["Title"] = "Access Denied";
}

<div class="card-custom text-center" style="max-width:500px; margin: 50px auto;">
    <i class="bi bi-shield-exclamation text-danger" style="font-size:4rem;"></i>
    <h3 class="mt-3">Access Denied</h3>
    <p class="text-muted">You don't have permission to access this page.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Go to Login</a>
</div>
