@model SmartAttendance.Models.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<!-- Welcome Section -->
<div class="card-custom mb-4" style="background-color: #2c3e50; color: #fff; border: none;">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="bi bi-hand-wave me-2"></i>Welcome back, @Model.StudentName!
            </h4>
            <p class="mb-0" style="color: rgba(255,255,255,0.7);">
                <code style="color: #ecf0f1;">@Model.StudentCode</code>
                @if (!string.IsNullOrEmpty(Model.Department))
                {
                    <span class="mx-2">•</span>
                    <span>@Model.Department</span>
                }
                @if (!string.IsNullOrEmpty(Model.Batch))
                {
                    <span class="mx-2">•</span>
                    <span>Batch: @Model.Batch</span>
                }
            </p>
        </div>
        <div class="d-none d-md-block">
            <i class="bi bi-mortarboard-fill" style="font-size: 3rem; opacity: 0.3;"></i>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p>Enrolled Courses</p>
                    <h3>@Model.TotalEnrolledCourses</h3>
                </div>
                <div class="icon text-primary"><i class="bi bi-book-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p>Overall Attendance</p>
                    <h3 class="@(Model.OverallAttendancePercentage < 75 ? "text-danger" : "text-success")">@Model.OverallAttendancePercentage%</h3>
                </div>
                <div class="icon @(Model.OverallAttendancePercentage < 75 ? "text-danger" : "text-success")"><i class="bi bi-pie-chart-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p>Classes Attended</p>
                    <h3>@Model.TotalClassesAttended / @Model.TotalClassesConducted</h3>
                </div>
                <div class="icon text-info"><i class="bi bi-check2-all"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p>Low Attendance</p>
                    <h3 class="@(Model.LowAttendanceCourseCount > 0 ? "text-danger" : "")">@Model.LowAttendanceCourseCount</h3>
                </div>
                <div class="icon text-danger"><i class="bi bi-exclamation-triangle-fill"></i></div>
            </div>
        </div>
    </div>
</div>

@if (Model.LowAttendanceCourseCount > 0)
{
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert" style="border-radius: 12px;">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <div>
            <strong>Attention!</strong> You have <strong>@Model.LowAttendanceCourseCount course(s)</strong> with attendance below 75%. Please attend classes regularly to avoid issues.
        </div>
    </div>
}

<!-- Today's Classes -->
<div class="card-custom border-0 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-day text-warning me-2"></i>Today's Classes</h5>
        <span class="badge bg-secondary text-white py-2 px-3 rounded-pill">
            <i class="bi bi-calendar-event me-1"></i> @DateTime.Today.ToString("dddd, MMM d, yyyy")
        </span>
    </div>

    @if (!Model.TodayClasses.Any())
    {
        <div class="text-center p-4 bg-light rounded" style="border: 2px dashed #dee2e6;">
            <i class="bi bi-cup-hot text-muted" style="font-size: 2.5rem;"></i>
            <h6 class="mt-3 text-muted">No Classes Today</h6>
            <p class="text-muted small mb-0">Enjoy your free time!</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Time</th>
                        <th>Course</th>
                        <th>Section</th>
                        <th>Room</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cls in Model.TodayClasses)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-primary">
                                    <i class="bi bi-clock me-1"></i> @cls.StartTime.ToString("hh:mm tt") - @cls.EndTime.ToString("hh:mm tt")
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold">@cls.CourseName</div>
                                <div class="small text-muted">@cls.CourseCode</div>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@cls.Section</span>
                            </td>
                            <td>
                                @if(!string.IsNullOrEmpty(cls.Room))
                                {
                                    <span><i class="bi bi-geo-alt text-danger me-1"></i> @cls.Room</span>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Course-wise Attendance Overview -->
<div class="card-custom mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-bar-chart-line me-2"></i>Course-wise Attendance</h5>
        <a asp-action="AttendanceDetails" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-list-check"></i> View Full Details
        </a>
    </div>

    @if (!Model.CourseStats.Any())
    {
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle"></i> You are not enrolled in any courses yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Course</th>
                        <th>Section</th>
                        <th>Semester</th>
                        <th class="text-center">Classes</th>
                        <th class="text-center">Attended</th>
                        <th>Attendance</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CourseStats)
                    {
                        var barColor = c.AttendancePercentage >= 75 ? "#28a745" : c.AttendancePercentage >= 60 ? "#ffc107" : "#dc3545";
                        <tr>
                            <td>
                                <span class="badge bg-primary me-1">@c.CourseCode</span>
                                <span class="fw-semibold">@c.CourseName</span>
                            </td>
                            <td><span class="badge bg-secondary">@c.Section</span></td>
                            <td>@c.Semester</td>
                            <td class="text-center fw-bold">@c.TotalClasses</td>
                            <td class="text-center fw-bold">@c.PresentCount</td>
                            <td style="min-width: 150px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar" style="width: @c.AttendancePercentage%; background-color: @barColor;"></div>
                                    </div>
                                    <small class="fw-bold" style="min-width: 40px;">@c.AttendancePercentage%</small>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (c.IsLow)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> Low</span>
                                }
                                else if (c.TotalClasses == 0)
                                {
                                    <span class="badge bg-secondary">No Data</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Good</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Quick Links -->
<div class="row g-3">
    <div class="col-md-6">
        <a asp-action="AttendanceDetails" class="text-decoration-none">
            <div class="card-custom text-center" style="transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <i class="bi bi-list-check text-success" style="font-size: 2rem;"></i>
                <h6 class="mt-2 mb-1">My Attendance</h6>
                <small class="text-muted">Day-by-day attendance records</small>
            </div>
        </a>
    </div>
    <div class="col-md-6">
        <a asp-action="MyTimetable" class="text-decoration-none">
            <div class="card-custom text-center" style="transition: transform 0.2s; cursor: pointer;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
                <i class="bi bi-calendar-week text-info" style="font-size: 2rem;"></i>
                <h6 class="mt-2 mb-1">Class Timetable</h6>
                <small class="text-muted">Your weekly schedule</small>
            </div>
        </a>
    </div>
</div>
