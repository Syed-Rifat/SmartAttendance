@model Dictionary<string, decimal>
@{
    ViewData["Title"] = "My Attendance";
}

<h2>My Attendance</h2>

<div class="row mt-4">
    @foreach (var stat in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card @(stat.Value < 75 ? "border-danger" : "border-success")">
                <div class="card-header">
                    @stat.Key
                </div>
                <div class="card-body">
                    <h5 class="card-title text-center">@stat.Value%</h5>
                    @if (stat.Value < 75)
                    {
                        <p class="text-danger text-center"><small>Warning: Low Attendance</small></p>
                    }
                </div>
            </div>
        </div>
    }
</div>
