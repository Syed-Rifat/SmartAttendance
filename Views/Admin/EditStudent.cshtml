@model SmartAttendance.Models.ViewModels.StudentEditViewModel
@{
    ViewData["Title"] = "Edit Student";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0"><i class="bi bi-pencil-square text-warning"></i> Edit Student</h5>
        <a asp-action="Students" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Students</a>
    </div>

    <form asp-action="EditStudent" method="post">
        <input type="hidden" asp-for="StudentId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <div class="border rounded p-3 mb-3">
            <h6 class="text-muted mb-3"><i class="bi bi-person-lines-fill"></i> Student Details</h6>
            <div class="row">
                <div class="col-md-4 mb-2">
                    <label asp-for="StudentCode" class="form-label small fw-semibold">Student Code <span class="text-danger">*</span></label>
                    <input asp-for="StudentCode" class="form-control" />
                    <span asp-validation-for="StudentCode" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-2">
                    <label asp-for="FullName" class="form-label small fw-semibold">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-4 mb-2">
                    <label asp-for="Department" class="form-label small fw-semibold">Department <span class="text-danger">*</span></label>
                    <input asp-for="Department" class="form-control" />
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-2">
                    <label asp-for="Batch" class="form-label small fw-semibold">Batch <span class="text-danger">*</span></label>
                    <input asp-for="Batch" class="form-control" />
                    <span asp-validation-for="Batch" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-2">
                    <label asp-for="Section" class="form-label small fw-semibold">Section <span class="text-danger">*</span></label>
                    <input asp-for="Section" class="form-control" />
                    <span asp-validation-for="Section" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-2">
                    <label asp-for="ContactNumber" class="form-label small fw-semibold">Contact Number</label>
                    <input asp-for="ContactNumber" class="form-control" />
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Save Changes</button>
            <a asp-action="Students" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
