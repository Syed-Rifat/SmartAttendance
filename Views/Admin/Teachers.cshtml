@model IEnumerable<SmartAttendance.Models.ViewModels.TeacherListViewModel>
@{
    ViewData["Title"] = "Manage Teachers";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-person-badge"></i> Teachers</h5>
        <div>
            <a asp-action="CreateTeacher" class="btn btn-success btn-sm"><i class="bi bi-plus-lg"></i> Add Teacher</a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Dashboard</a>
        </div>
    </div>

    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Department</th>
                <th>Contact</th>
                <th>Username</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var teacher in Model)
            {
                <tr>
                    <td>@teacher.FullName</td>
                    <td>@teacher.Department</td>
                    <td>@teacher.ContactNumber</td>
                    <td>@teacher.Username</td>
                    <td>@teacher.Email</td>
                    <td>
                        <a asp-action="EditTeacher" asp-route-id="@teacher.TeacherId" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                        <form asp-action="DeleteTeacher" asp-route-id="@teacher.TeacherId" method="post" style="display:inline;" onsubmit="return confirm('Delete this teacher?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
