@model IEnumerable<SmartAttendance.Models.ViewModels.EnrollmentViewModel>
@{
    ViewData["Title"] = "Enrollments";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-person-plus"></i> Enrollments</h5>
        <div>
            <a asp-action="CreateEnrollment" class="btn btn-secondary btn-sm"><i class="bi bi-plus-lg"></i> Enroll Student</a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Dashboard</a>
        </div>
    </div>

    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>Student</th>
                <th>Course</th>
                <th>Section</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.StudentCode - @item.StudentName</td>
                    <td>@item.CourseName</td>
                    <td>@item.Section</td>
                    <td>
                        <a asp-action="EditEnrollment" asp-route-id="@item.EnrollmentId" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                        <form asp-action="DeleteEnrollment" asp-route-id="@item.EnrollmentId" method="post" style="display:inline;" onsubmit="return confirm('Remove?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
