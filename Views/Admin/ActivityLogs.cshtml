@model IEnumerable<SmartAttendance.Models.ViewModels.ActivityLogViewModel>
@{
    ViewData["Title"] = "Activity Logs";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Activity Logs (Last 100)</h5>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Dashboard</a>
    </div>

    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>Timestamp</th>
                <th>User</th>
                <th>Action</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@log.Username</td>
                    <td><span class="badge bg-secondary">@log.Action</span></td>
                    <td>@log.Description</td>
                </tr>
            }
        </tbody>
    </table>
</div>
