@model SmartAttendance.Models.ViewModels.EnrollmentViewModel
@{
    ViewData["Title"] = "Edit Enrollment";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0"><i class="bi bi-pencil-square text-info"></i> Edit Student Enrollment</h5>
        <a asp-action="Enrollments" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    <form asp-action="EditEnrollment" method="post">
        <input type="hidden" asp-for="EnrollmentId" />
        
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StudentId" class="form-label small fw-semibold">Select Student <span class="text-danger">*</span></label>
                <select asp-for="StudentId" asp-items="Model.Students" class="form-select">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="AssignmentId" class="form-label small fw-semibold">Select Course Assignment <span class="text-danger">*</span></label>
                <select asp-for="AssignmentId" asp-items="Model.Assignments" class="form-select">
                    <option value="">-- Select Assignment --</option>
                </select>
                <span asp-validation-for="AssignmentId" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-info text-white"><i class="bi bi-check-circle"></i> Update Enrollment</button>
            <a asp-action="Enrollments" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
