@model SmartAttendance.Models.ViewModels.CourseAssignmentViewModel
@{
    ViewData["Title"] = "Edit Assignment";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0"><i class="bi bi-pencil-square text-info"></i> Edit Course Assignment</h5>
        <a asp-action="Assignments" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
    </div>

    <form asp-action="EditAssignment" method="post">
        <input type="hidden" asp-for="AssignmentId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <div class="border rounded p-3 mb-3" style="background:#f8f9fa;">
            <h6 class="text-muted mb-3"><i class="bi bi-link-45deg"></i> Assignment</h6>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label asp-for="TeacherId" class="form-label small fw-semibold">Teacher <span class="text-danger">*</span></label>
                    <select asp-for="TeacherId" asp-items="Model.Teachers" class="form-select">
                        <option value="">-- Select Teacher --</option>
                    </select>
                    <span asp-validation-for="TeacherId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-2">
                    <label asp-for="CourseId" class="form-label small fw-semibold">Course <span class="text-danger">*</span></label>
                    <select asp-for="CourseId" asp-items="Model.Courses" class="form-select">
                        <option value="">-- Select Course --</option>
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <h6 class="text-muted mb-3"><i class="bi bi-calendar-event"></i> Details</h6>
            <div class="row">
                <div class="col-md-3 mb-2">
                    <label asp-for="Section" class="form-label small fw-semibold">Section <span class="text-danger">*</span></label>
                    <input asp-for="Section" class="form-control" placeholder="e.g. A" />
                    <span asp-validation-for="Section" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-2">
                    <label asp-for="Semester" class="form-label small fw-semibold">Semester <span class="text-danger">*</span></label>
                    <input asp-for="Semester" class="form-control" placeholder="e.g. Spring 2025" />
                    <span asp-validation-for="Semester" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-2">
                    <label asp-for="AcademicYear" class="form-label small fw-semibold">Academic Year <span class="text-danger">*</span></label>
                    <input asp-for="AcademicYear" class="form-control" placeholder="e.g. 2024-25" />
                    <span asp-validation-for="AcademicYear" class="text-danger small"></span>
                </div>
                <div class="col-md-3 mb-2">
                    <label asp-for="Room" class="form-label small fw-semibold">Room</label>
                    <input asp-for="Room" class="form-control" placeholder="e.g. 301" />
                </div>
            </div>
        </div>

        <div class="border rounded p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-muted mb-0"><i class="bi bi-clock-history"></i> Class Schedule Slots</h6>
                <button type="button" class="btn btn-sm btn-primary" id="addSlotBtn">
                    <i class="bi bi-plus-circle"></i> Add Slot
                </button>
            </div>
            <p class="text-muted small mb-3">Add one row per day this course meets. A 3-credit course meeting Sun, Mon, Thu needs 3 rows.</p>
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Day of Week</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th style="width:60px;"></th>
                        </tr>
                    </thead>
                    <tbody id="scheduleSlotsContainer">
                    </tbody>
                </table>
            </div>
            <input asp-for="Schedule" type="hidden" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-info text-white"><i class="bi bi-check-circle"></i> Update Assignment</button>
            <a asp-action="Assignments" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            let slotIndex = 0;
            const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

            function buildDayOptions(selected) {
                let opts = '<option value="">-- Day --</option>';
                days.forEach(function(d) {
                    opts += '<option value="' + d + '"' + (selected === d ? ' selected' : '') + '>' + d + '</option>';
                });
                return opts;
            }

            function addSlot(day, start, end) {
                day = day || '';
                start = start || '';
                end = end || '';
                var idx = slotIndex;
                var row = '<tr class="schedule-slot" data-index="' + idx + '">' +
                    '<td><select name="ScheduleSlots[' + idx + '].DayOfWeek" class="form-select form-select-sm">' + buildDayOptions(day) + '</select></td>' +
                    '<td><input type="time" name="ScheduleSlots[' + idx + '].StartTime" class="form-control form-control-sm" value="' + start + '" /></td>' +
                    '<td><input type="time" name="ScheduleSlots[' + idx + '].EndTime" class="form-control form-control-sm" value="' + end + '" /></td>' +
                    '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-slot"><i class="bi bi-x-lg"></i></button></td>' +
                    '</tr>';
                $("#scheduleSlotsContainer").append(row);
                slotIndex++;
            }

            function reIndex() {
                $(".schedule-slot").each(function(i) {
                    $(this).attr("data-index", i);
                    $(this).find("select").attr("name", "ScheduleSlots[" + i + "].DayOfWeek");
                    $(this).find("input[type='time']").eq(0).attr("name", "ScheduleSlots[" + i + "].StartTime");
                    $(this).find("input[type='time']").eq(1).attr("name", "ScheduleSlots[" + i + "].EndTime");
                });
                slotIndex = $(".schedule-slot").length;
            }

            $("#addSlotBtn").on("click", function() { addSlot('', '', ''); });

            $(document).on("click", ".remove-slot", function() {
                $(this).closest("tr").remove();
                reIndex();
            });

            @if (Model.ScheduleSlots != null && Model.ScheduleSlots.Any())
            {
                foreach (var slot in Model.ScheduleSlots)
                {
                    <text>addSlot('@slot.DayOfWeek', '@slot.StartTime', '@slot.EndTime');</text>
                }
            }
            else
            {
                <text>addSlot('', '', '');</text>
            }
        });
    </script>
}
