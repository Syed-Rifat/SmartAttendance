@model SmartAttendance.Models.ViewModels.EnrollmentViewModel
@{
    ViewData["Title"] = "Enroll Student";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0"><i class="bi bi-person-plus-fill text-secondary"></i> Enroll Student</h5>
        <a asp-action="Enrollments" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
    <form asp-action="CreateEnrollment" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>
        <div class="border rounded p-3 mb-3">
            <h6 class="text-muted mb-3"><i class="bi bi-link-45deg"></i> Enrollment Details</h6>
            <div class="row">
                <div class="col-md-6 mb-2">
                    <label asp-for="StudentId" class="form-label small fw-semibold">Student <span class="text-danger">*</span></label>
                    <select asp-for="StudentId" asp-items="Model.Students" class="form-select"><option value="">-- Select Student --</option></select>
                </div>
                <div class="col-md-6 mb-2">
                    <label asp-for="AssignmentId" class="form-label small fw-semibold">Course Assignment <span class="text-danger">*</span></label>
                    <select asp-for="AssignmentId" asp-items="Model.Assignments" class="form-select"><option value="">-- Select Course --</option></select>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-secondary"><i class="bi bi-check-circle"></i> Enroll</button>
            <a asp-action="Enrollments" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
