@model SmartAttendance.Models.ViewModels.BulkUploadViewModel
@{
    ViewData["Title"] = "Bulk Upload Students";
}

<h2>Bulk Upload Students</h2>
<p>Upload a CSV file to create multiple students at once. The first row must be a header row.</p>
<p><strong>Required Columns (in order):</strong> Username, Email, Password, StudentCode, FullName, Department, Batch, Section, ContactNumber</p>

<div class="row">
    <div class="col-md-6">
        @if (!string.IsNullOrEmpty(Model?.Message))
        {
            <div class="alert alert-info">@Model.Message</div>
        }

        <form asp-action="BulkUploadStudents" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="File" class="form-label">Select CSV File</label>
                <input asp-for="File" type="file" class="form-control" accept=".csv" required />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Upload</button>
            <a asp-action="Students" class="btn btn-secondary">Back to Students</a>
        </form>
    </div>
</div>
