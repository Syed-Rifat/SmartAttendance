@model IEnumerable<SmartAttendance.Models.ViewModels.CourseAssignmentViewModel>
@{
    ViewData["Title"] = "Course Assignments";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Course Assignments</h5>
        <div>
            <a asp-action="CreateAssignment" class="btn btn-info btn-sm text-white"><i class="bi bi-plus-lg"></i> Assign Course</a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Dashboard</a>
        </div>
    </div>

    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>Course</th>
                <th>Teacher</th>
                <th>Section</th>
                <th>Semester</th>
                <th>Year</th>
                <th>Room / Schedule</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CourseCode - @item.CourseName</td>
                    <td>@item.TeacherName</td>
                    <td>@item.Section</td>
                    <td>@item.Semester</td>
                    <td>@item.AcademicYear</td>
                    <td>@item.Room / @item.Schedule</td>
                    <td>
                        <form asp-action="DeleteAssignment" asp-route-id="@item.AssignmentId" method="post" style="display:inline;" onsubmit="return confirm('Delete?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
