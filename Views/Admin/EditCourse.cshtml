@model SmartAttendance.Models.ViewModels.CourseViewModel
@{
    ViewData["Title"] = "Edit Course";
}

<div class="card-custom">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-0"><i class="bi bi-pencil-square text-warning"></i> Edit Course</h5>
        <a asp-action="Courses" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back to Courses</a>
    </div>

    <form asp-action="EditCourse" method="post">
        <input type="hidden" asp-for="CourseId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <div class="border rounded p-3 mb-3">
            <h6 class="text-muted mb-3"><i class="bi bi-book-fill"></i> Course Information</h6>
            <div class="row">
                <div class="col-md-3 mb-2">
                    <label asp-for="CourseCode" class="form-label small fw-semibold">Course Code <span class="text-danger">*</span></label>
                    <input asp-for="CourseCode" class="form-control" />
                </div>
                <div class="col-md-3 mb-2">
                    <label asp-for="CourseName" class="form-label small fw-semibold">Course Name <span class="text-danger">*</span></label>
                    <input asp-for="CourseName" class="form-control" />
                </div>
                <div class="col-md-3 mb-2">
                    <label asp-for="Department" class="form-label small fw-semibold">Department <span class="text-danger">*</span></label>
                    <input asp-for="Department" class="form-control" />
                </div>
                <div class="col-md-3 mb-2">
                    <label asp-for="CreditHours" class="form-label small fw-semibold">Credit Hours <span class="text-danger">*</span></label>
                    <input asp-for="CreditHours" class="form-control" type="number" min="1" max="10" />
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Save Changes</button>
            <a asp-action="Courses" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
